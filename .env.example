# ======================
# Nova Agent Configuration
# ======================

# Wajib - Secret key untuk Bearer authentication (buat yang kuat!)
# Generate dengan: python -c "import secrets; print(secrets.token_urlsafe(32))"
NOVA_API_KEY=change-me-to-a-very-long-random-string-at-least-32-chars

# Path absolut ke folder yang akan dikelola
REPO_PATH=/home/username/path/to/your/repo

# Mode operasi:
#   auto    = file ops selalu aktif; git aktif otomatis jika path adalah git repo (default, recommended)
#   git     = wajib git repository (error jika bukan)
#   folder  = hanya file operations (git dimatikan)
MODE=auto

# Port lokal server (default 8080)
PORT=8080

# Host (biarkan 127.0.0.1 untuk keamanan maksimal)
HOST=127.0.0.1

# Auto-shutdown setelah X menit tidak ada request (0 = disable)
IDLE_TIMEOUT_MINUTES=30

# Maksimal ukuran file yang boleh dibaca/ditulis (dalam MB)
MAX_FILE_SIZE_MB=5

# Izinkan operasi write (false = read-only mode)
ALLOW_WRITE=true

# Izinkan git push (sangat berisiko jika API key bocor)
ALLOW_PUSH=true

# Izinkan menjalankan test/linter
ALLOW_QUALITY_COMMANDS=true

# Izinkan operasi branch (create / delete / checkout / rename)
ALLOW_BRANCH_OPS=true

# GitHub Personal Access Token (opsional - hanya dibutuhkan jika mau push via token)
# Jangan commit file ini! Token hanya dipakai di server lokal.
GITHUB_TOKEN=

# ======================
# Tunnel Configuration
# ======================
# Pilihan: ngrok | cloudflare | none
TUNNEL_PROVIDER=cloudflare

# --- Cloudflare Tunnel ---
# Untuk quick tunnel (trycloudflare.com): biarkan kosong
# Untuk named tunnel: isi tunnel name + credentials file
CLOUDFLARE_TUNNEL_NAME=
CLOUDFLARE_CREDENTIALS_FILE=

# --- ngrok ---
# Authtoken dari dashboard ngrok.com
NGROK_AUTHTOKEN=
# Domain statis (hanya plan berbayar)
NGROK_DOMAIN=

# ======================
# Logging & Security
# ======================
LOG_LEVEL=INFO
# Simpan audit log ke file
AUDIT_LOG_FILE=./logs/audit.log

# Rate limiting (request per menit per IP)
RATE_LIMIT_PER_MINUTE=30
